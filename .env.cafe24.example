# 카페24 FTP 접속 정보 (이 파일을 .env.cafe24 로 복사한 뒤 비밀번호를 입력하세요)
# .env.cafe24 는 git에 올라가지 않습니다.

REMOTE_HOST=tbctest.mycafe24.com
REMOTE_USER=tbctest
REMOTE_PASSWORD=여기에_FTP_비밀번호
REMOTE_BASE_DIR=/www

# FTP (카페24 일반형 기본)
FILE_TRANSPORT=ftp
FTP_PORT=21
FTP_SECURITY=ftp

# 삭제 도구는 기본 비활성. 필요할 때만 true
# REMOTE_ALLOW_DELETE=true
